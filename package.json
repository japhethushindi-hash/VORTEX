{
  "name": "vortex-learning",
  "version": "1.3.0",
  "description": "VORTEX programming learning platform with IntaSend billing integration starter",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start:desktop": "electron .",
    "dist:win": "electron-builder --win nsis",
    "test": "node tests/smoke-test.cjs",
    "start:server": "node server/index.cjs",
    "test:billing": "node --check server/index.cjs && node --check app.js"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.vortex.learnbuild",
    "productName": "VORTEX Learning",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "python-lab.js",
      "desktop/**/*",
      "server/index.cjs",
      "server/.env.example",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "VORTEX-Learning-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "connect-sqlite3": "^0.9.16",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0"
  }
}
